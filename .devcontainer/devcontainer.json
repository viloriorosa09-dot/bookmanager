{
  "name": "BookManager",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "web",
  "workspaceFolder": "/var/www/html",
  "forwardPorts": [8080, 8081, 3306],
  "portsAttributes": {
    "8080": { "label": "BookManager" },
    "8081": { "label": "phpMyAdmin" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "jebbs.plantuml",
        "xdebug.php-debug"
      ]
    }
  }
}
