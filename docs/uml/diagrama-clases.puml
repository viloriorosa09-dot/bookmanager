@startuml
skinparam classAttributeIconSize 0

interface ListableInterface {
  +getAll(): array
}

interface CrudInterface {
  +getById(id: string): ?array
  +create(datos: array): bool
  +update(id: string, datos: array): bool
  +delete(id: string): bool
}

class Database {
  -conexion: PDO
  +__construct()
  +getConexion(): PDO
}

class Tienda {
  -db: PDO
  +__construct(db: PDO)
  +getAll(): array
  +getById(id: string): ?array
  +create(datos: array): bool
  +update(id: string, datos: array): bool
  +delete(id: string): bool
  +tieneRegistros(id: string): bool
  +{static} depurar(post: array): array
  +{static} validar(datos: array, validarId: bool): array
}

class Publicador {
  -db: PDO
  +__construct(db: PDO)
  +getAll(): array
  +getById(id: string): ?array
  +create(datos: array): bool
  +update(id: string, datos: array): bool
  +delete(id: string): bool
  +tieneTitulos(id: string): bool
}

class Titulo {
  -db: PDO
  +__construct(db: PDO)
  +getAll(): array
  +getById(id: string): ?array
  +create(datos: array): bool
  +update(id: string, datos: array): bool
  +delete(id: string): bool
}

ListableInterface <|-- CrudInterface
CrudInterface <|.. Tienda
CrudInterface <|.. Publicador
CrudInterface <|.. Titulo

Database "1" --> "*" Tienda : provee conexión
Database "1" --> "*" Publicador : provee conexión
Database "1" --> "*" Titulo : provee conexión
Publicador "1" -- "*" Titulo : publica
@enduml
